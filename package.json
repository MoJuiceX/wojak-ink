{
  "name": "wojak-ink-redesign",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "nightshift:bootstrap": "bash scripts/nightshift-bootstrap.sh",
    "nightshift:dry-run": "node scripts/nightshift.mjs --dry-run",
    "nightshift:report": "node scripts/nightshift.mjs --real --report-only --max-hours=8 --max-tasks=20 --soft-failures=5 --hard-failures=10",
    "nightshift:run": "node scripts/nightshift.mjs --real --max-hours=8 --max-tasks=20 --soft-failures=5 --hard-failures=10",
    "nightshift:resume": "node scripts/nightshift.mjs --resume --real --max-hours=8 --max-tasks=20 --soft-failures=5 --hard-failures=10",
    "verify-manifest": "node scripts/verify-manifest-assets.mjs",
    "bundle:report": "node scripts/bundle-budget-report.mjs",
    "infra:validate": "./scripts/validate-github-workflows.sh && ./scripts/validate-terraform.sh && ./scripts/validate-k8s-manifests.rb",
    "infra:validate:workflows": "./scripts/validate-github-workflows.sh",
    "infra:validate:terraform": "./scripts/validate-terraform.sh",
    "infra:validate:k8s": "./scripts/validate-k8s-manifests.rb",
    "build:wallet-standalone": "node scripts/build-wallet-connect-standalone.mjs",
    "build": "node scripts/verify-manifest-assets.mjs && tsc -b && npm run build:wallet-standalone && vite build",
    "icons": "node scripts/generate-icons.mjs",
    "build:prerender": "npm run build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "lint:scoped": "eslint src functions workers tests scripts --ext .ts,.tsx,.js,.mjs,.cjs",
    "lint:app": "eslint src --ext .ts,.tsx",
    "lint:src": "npm run lint:app",
    "lint:functions": "eslint functions --ext .ts",
    "lint:workers": "eslint workers --ext .ts",
    "lint:scripts": "eslint scripts --ext .js,.mjs,.cjs,.ts",
    "health": "./scripts/health-check.sh",
    "precommit": "npm run lint:scoped -- --max-warnings=0",
    "preview": "vite preview",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.59.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-oauth/google": "^0.13.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.16",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/sign-client": "^2.23.3",
    "@walletconnect/types": "^2.23.3",
    "@walletconnect/utils": "^2.23.3",
    "canvas-confetti": "^1.9.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.25.0",
    "howler": "^2.2.4",
    "html2canvas": "^1.4.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.562.0",
    "matter-js": "^0.20.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.12.0",
    "socket.io-client": "^4.7.2",
    "swiper": "^12.1.2",
    "zustand": "^5.0.9"
  },
  "overrides": {
    "react-helmet-async": {
      "react": "$react"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.12",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.1.1",
    "bech32": "^2.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.6.0",
    "puppeteer": "^24.35.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
